# Copy to .env (not versioned). Used to interpolate compose.yaml and also
# injected as environment into the opencode container. bin/ocbox loads it
# too, before projects/<name>.env.

# --- OpenCode 2 ---------------------------------------------------------------
# Version of the @opencode/cli npm package. Pin it for reproducible builds
# (changing it invalidates the cache); on "latest", use ocbox --rebuild to update.
OPENCODE_VERSION=latest

# --- Serena -------------------------------------------------------------------
# Installed in the image; enabled per project (OCBOX_SERENA=1 or --serena).
# INSTALL_SERENA=0
SERENA_VERSION=2.1.0
# Serena's web dashboard, published on 127.0.0.1 (only when Serena is on).
# OCBOX_SERENA_DASHBOARD=1
# OCBOX_SERENA_DASHBOARD_PORT=24282
# 1 = expose Serena's tools through OpenCode's Code Mode
# (by default they go directly into the model's tool list).
# OCBOX_SERENA_CODEMODE=0

# --- Provider keys (alternative to /connect inside the TUI) -------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# --- Git identity (only useful with --git-rw) ---------------------------------
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# --- Services -----------------------------------------------------------------
# Every services/<name>.yaml has defaults; uncomment what you want to change
# for all projects (or put it in projects/<name>.env for a single one).
# POSTGRES_VERSION=17
# POSTGRES_USER=dev
# POSTGRES_PASSWORD=dev
# POSTGRES_DB=app
# MARIADB_VERSION=11
# MONGO_VERSION=8
# REDIS_VERSION=7
# VALKEY_VERSION=8
# RABBITMQ_VERSION=4
# Ports published on 127.0.0.1 (UIs and proxy):
# MAILPIT_UI_PORT=8025
# MINIO_CONSOLE_PORT=9001
# RABBITMQ_UI_PORT=15672
# CADDY_PORT=8080
# PROXY_UPSTREAM=opencode:3000

# --- Misc ---------------------------------------------------------------------
# Container user UID/GID (defaults to yours). Rootless Docker: set both to 0.
# OCBOX_HOST_UID=0
# OCBOX_HOST_GID=0
# Disable the automatic 'mise install' on startup.
# OCBOX_MISE_INSTALL=0
