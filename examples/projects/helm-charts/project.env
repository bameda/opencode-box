# Helm charts: static validation, installs against a simulated Kubernetes
# API, and a local OCI registry for packaged charts.
OCBOX_SERVICES=kwok,registry

# Serena adds little for YAML and templates.
OCBOX_SERENA=0

# Kubernetes version of the simulated cluster (see services/kwok/README.md).
# KWOK_VERSION=v0.8.0-k8s.v1.34.8
