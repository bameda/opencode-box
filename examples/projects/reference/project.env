# Example using every piece a project can have. Copy this directory to
# ~/.config/roke/projects/<project-directory-name>/ and adapt it.
#
# Everything here is exported, so it can also change service versions,
# credentials or ports for this project only. It is also passed to the
# box as environment variables.

# Services, comma-separated: from this project's services/, from your own
# services/ or from the catalog (roke service shows them all).
ROKE_SERVICES=postgres,valkey,mailpit,elasticsearch

# Ports of the box to publish on 127.0.0.1 (space-separated).
ROKE_PORTS="5173"

# 1 = the agent can commit (mounts .git read-write).
ROKE_GIT_RW=0

# 1 = enable Serena (semantic code navigation/editing via LSP).
ROKE_SERENA=1

# Service settings for this project
POSTGRES_DB=myapp
# A different port so another project with mailpit can be open at the same time
MAILPIT_UI_PORT=18025
