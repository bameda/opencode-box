# Copy to projects/<directory-name>.env
# Everything here is exported, so it can also change service versions,
# credentials or ports for this project only.

# Catalog services (directories in services/), comma-separated.
OCBOX_SERVICES=postgres,valkey,mailpit,caddy

# Ports of the opencode container to publish on 127.0.0.1 (space-separated).
OCBOX_PORTS="5173"

# 1 = the agent can commit (mounts .git read-write).
OCBOX_GIT_RW=0

# 1 = enable Serena (semantic code navigation/editing via LSP).
OCBOX_SERENA=1

# Service settings for this project
POSTGRES_DB=myapp
# Different ports so another project can be open at the same time
MAILPIT_UI_PORT=18025
CADDY_PORT=18080
PROXY_UPSTREAM=opencode:5173
