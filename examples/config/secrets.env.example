# Secrets for ocbox: loaded after ocbox.env and injected into the opencode
# container. Listed in .gitignore, so it is never committed.
#
# Provider API keys are only needed if you don't log in with /connect inside
# opencode (that login is stored in the box's own volume instead).

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
