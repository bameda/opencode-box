# Secrets for ocbox: loaded after ocbox.env and passed to the box as
# environment variables. Listed in .gitignore, so it is never committed.
#
# Provider API keys are only needed if you don't log in from inside the
# agent (/connect in OpenCode, the login prompt in Claude Code); that login
# is stored in the box's own volume instead.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
