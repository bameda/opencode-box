{
  "$schema": "https://opencode.ai/config.json",
  // The image decides the version (OPENCODE_VERSION in ocbox.env + ocbox --build).
  "update": "disable"

  // Your default model, agents, permissions, global MCPs, etc. go here.
  // Agents, commands and skills can also live in agents/, commands/ and
  // skills/ next to this file.
  // Serena is NOT defined here: the entrypoint adds it to /etc/opencode only
  // for projects with OCBOX_SERENA=1.
}
