# Global settings for roke, for every project. Loaded first: the settings
# in projects/<name>/project.env take precedence. Also passed as environment
# variables to the box. Safe to commit: keep secrets in secrets.env.

# --- Coding agent ------------------------------------------------------------
# The agent to run: claude, codex or opencode (roke agent shows them all).
# There is no default: with several agents installed, choose one here, per
# project in projects/<name>/project.env, or with roke --agent for one run.
# roke agent use NAME (per project) and roke agent use NAME --global (here)
# change it for you.
# ROKE_AGENT=

# Agents installed in the image, space-separated. Leave only the ones you use
# to make the image smaller. Rebuild after changing (roke build).
# ROKE_AGENTS="claude codex opencode"

# Versions, as agent=version pairs (rebuild after changing). Without one,
# each agent uses its default: claude "stable" (a week behind, skipping
# releases with major regressions), codex and opencode "latest".
# ROKE_AGENT_VERSIONS="claude=stable codex=latest opencode=latest"

# --- Network ------------------------------------------------------------------
# restricted (default): only allowed destinations; open: no limits. Per
# project in project.env, or roke --network for one run. See docs/network.md.
# ROKE_NETWORK=restricted
# Destinations allowed for every project (projects add theirs with
# roke network add): domains, IPs or CIDRs, each with an optional :port.
# ROKE_NETWORK_ALLOW="api.example.com git.corp.example.com:22"

# --- Serena -------------------------------------------------------------------
# Installed in the image; enabled per project (ROKE_SERENA=1 or --serena).
# INSTALL_SERENA=0
SERENA_VERSION=2.1.0
# Serena's web dashboard, published on 127.0.0.1 (only when Serena is on).
# ROKE_SERENA_DASHBOARD=1
# ROKE_SERENA_DASHBOARD_PORT=24282
# OpenCode only: 1 = expose Serena's tools through its Code Mode (by default
# they go directly into the model's tool list).
# ROKE_SERENA_CODEMODE=0

# --- Git identity (only useful with --git-rw) ---------------------------------
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# --- Services -----------------------------------------------------------------
# Every services/<name>/compose.yaml has defaults; uncomment what you want to change
# for all projects (or put it in projects/<name>/project.env for one).
# PostgreSQL major (18 or newer). Changing it starts an empty database; see
# "PostgreSQL major upgrades" in the README. When moving to a newer major,
# bump POSTGRES_CLIENT_VERSION too and run roke build.
# POSTGRES_VERSION=18
# POSTGRES_CLIENT_VERSION=18
# POSTGRES_USER=dev
# POSTGRES_PASSWORD=dev
# POSTGRES_DB=app
# MARIADB_VERSION=11
# MONGO_VERSION=8
# REDIS_VERSION=7
# VALKEY_VERSION=8
# RABBITMQ_VERSION=4
# Ports published on 127.0.0.1 (UIs and proxy):
# MAILPIT_UI_PORT=8025
# RUSTFS_CONSOLE_PORT=9001
# SEAWEEDFS_UI_PORT=8888
# PROMETHEUS_UI_PORT=9090
# GRAFANA_UI_PORT=3001
# RABBITMQ_UI_PORT=15672
# CADDY_PORT=8080
# PROXY_UPSTREAM=box:3000

# --- Misc ---------------------------------------------------------------------
# Container user UID/GID (defaults to yours). Rootless Docker: set both to 0.
# ROKE_HOST_UID=0
# ROKE_HOST_GID=0
# Disable the automatic 'mise install' on startup.
# ROKE_MISE_INSTALL=0
