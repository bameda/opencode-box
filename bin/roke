#!/usr/bin/env bash
# roke — run a coding agent in a container that can only see the given project,
# plus whatever auxiliary services (DB, cache, mail, proxy...) you ask for.
set -euo pipefail

BOX_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
SERVICES_DIR="$BOX_DIR/services"
# Your personal configuration (settings, projects, agent configuration), kept
# outside this repository.
CONFIG_DIR="${ROKE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/roke}"
USER_SERVICES_DIR="$CONFIG_DIR/services"
PROJECT_SERVICES_DIR=""   # set once the project is known

die()  { printf 'roke: %s\n' "$*" >&2; exit 1; }
info() { printf '[roke] %s\n' "$*" >&2; }

usage() {
  cat <<'USAGE'
Usage: roke [-C DIR] [COMMAND] [OPTIONS]

Run a coding agent in a container that can only see the project in the
current directory (or DIR, with -C).

The project's box
  roke [run]                 Start the agent
  roke continue              Resume the agent's last session
  roke shell                 Open bash in the box
  roke exec CMD...           Run a command in the box
  roke urls                  Where the app and the services are
  roke settings              Every setting of the project and where it comes from
  roke build [--no-cache]    Build the images
  roke down [--all]          Stop the project's containers, or every project's;
                             their data is kept
  roke purge                 Stop them and delete all the project's data

Agents
  roke agent                 The agents, and the one this project uses
  roke agent use NAME        Use NAME in this project (--global: by default)
  roke agent reset           This project uses the default agent again

Services
  roke service               The services, and the ones this project uses
  roke service add NAME...   Add services to this project
  roke service rm NAME...    Remove them from it (their data is kept)

Network
  roke network               The network mode and the allowed destinations
  roke network add DEST      Allow a destination in this project (--global: in
                             every project): a domain, IP or CIDR, with an
                             optional :port, such as db.example.com:5432
  roke network rm DEST       Stop allowing it (--global: in every project)
  roke network blocked       What the project tried to reach and was denied

roke itself
  roke init [GIT_URL]        Create ~/.config/roke, cloning GIT_URL if given
  roke update                Update roke (then roke build)
  roke help [COMMAND]        This help, or a command's part of it

Options for run, continue, shell and exec, for this time only (-s and -p
also apply to roke urls):
  -a, --agent NAME           Use another agent
  -s, --services LIST        Start these services instead, comma-separated
  -p, --port PORT            Publish a port of the box on 127.0.0.1 (repeatable)
      --network MODE         restricted or open
      --git-rw               Let the agent write to .git, so it can commit
      --serena, --no-serena  Enable or disable Serena

Settings live in ~/.config/roke (or $ROKE_CONFIG_DIR): roke.env for every
project and projects/<dir-name>/ for each one. See docs/usage.md.
USAGE
}

# help_for COMMAND: the part of the help about COMMAND.
help_for() {
  local section
  case "$1" in
    run|continue|shell|exec|urls|settings|build|down|purge) section="The project's box" ;;
    agent)   section="Agents" ;;
    service) section="Services" ;;
    network) section="Network" ;;
    init|update|help) section="roke itself" ;;
    *) die "no help for '$1' (commands: run continue shell exec urls settings build down purge agent service network init update help)" ;;
  esac
  usage | awk -v s="$section" '$0 == s {p=1} p && /^$/ {exit} p'
  if [[ "$section" == "The project's box" ]]; then
    echo
    usage | awk '/^Options for run/ {p=1} p && /^$/ {exit} p'
  fi
}

# Each agent is a directory agents/<name>/ with an install.sh and a setup.sh.
available_agents() {
  local d
  for d in "$BOX_DIR"/agents/*/; do
    [[ -f "$d/setup.sh" ]] || continue
    d="$(basename "$d")"
    [[ "$d" == _* ]] || printf '%s\n' "$d"
  done
}

# Each service is a directory <name>/ with a compose.yaml inside. They are
# looked up in the project's configuration, then in yours, then in the
# catalog: the first one found wins.
service_dirs() {
  [[ -n "$PROJECT_SERVICES_DIR" ]] && printf '%s\n' "$PROJECT_SERVICES_DIR"
  printf '%s\n' "$USER_SERVICES_DIR" "$SERVICES_DIR"
}

available_services() {
  local dir d
  while read -r dir; do
    for d in "$dir"/*/; do
      [[ -f "$d/compose.yaml" ]] || continue
      d="$(basename "$d")"
      [[ "$d" == _* ]] || printf '%s\n' "$d"
    done
  done < <(service_dirs) | sort -u
}

service_file() {
  local dir
  while read -r dir; do
    if [[ -f "$dir/$1/compose.yaml" ]]; then
      printf '%s/%s/compose.yaml' "$dir" "$1"
      return
    fi
  done < <(service_dirs)
  printf '%s/%s/compose.yaml' "$SERVICES_DIR" "$1"
}

init_config() {
  local repo="${1:-}" created=0 src rel
  if [[ -n "$repo" ]]; then
    if [[ -e "$CONFIG_DIR" ]]; then
      die "$CONFIG_DIR already exists; remove it or move it away to clone $repo"
    fi
    command -v git >/dev/null || die "git is not installed"
    git clone "$repo" "$CONFIG_DIR"
  fi
  mkdir -p "$CONFIG_DIR"
  while IFS= read -r -d '' src; do
    rel="${src#"$BOX_DIR/examples/config/"}"
    # Files the example's own .gitignore would hide from git are stored as
    # <name>.example (secrets.env.example -> secrets.env).
    rel="${rel%.example}"
    if [[ ! -e "$CONFIG_DIR/$rel" ]]; then
      mkdir -p "$(dirname "$CONFIG_DIR/$rel")"
      cp "$src" "$CONFIG_DIR/$rel"
      echo "  created $rel"
      created=1
    fi
  done < <(find "$BOX_DIR/examples/config" -type f -print0 | sort -z)
  chmod 600 "$CONFIG_DIR/secrets.env" 2>/dev/null || true
  ((created)) || echo "  nothing to do: every file already exists"
  echo "Configuration directory: $CONFIG_DIR"
  if [[ ! -d "$CONFIG_DIR/.git" ]]; then
    echo "Tip: make it a private git repo: git -C \"$CONFIG_DIR\" init"
  fi
}

list_agents() {
  local s desc
  echo "Agents (roke agent use NAME; --global for the default):"
  while read -r s; do
    desc="$(sed -n '1s/^# *//p' "$BOX_DIR/agents/$s/README.md" 2>/dev/null)"
    [[ " ${installed_agents:-} " == *" $s "* ]] || desc="$desc (not installed)"
    [[ "$s" == "${ROKE_AGENT:-}" ]] && desc="$desc  <- used here (${agent_source:-})"
    printf '  %-12s %s\n' "$s" "$desc"
  done < <(available_agents)
}

list_services() {
  local s desc mark
  echo "Services (roke service add NAME; * = used by this project):"
  while read -r s; do
    desc="$(sed -n '1s/^# *//p' "$(service_file "$s")")"
    case "$(service_file "$s")" in
      "$PROJECT_SERVICES_DIR"/*) desc="[project] $desc" ;;
      "$USER_SERVICES_DIR"/*)    desc="[yours] $desc" ;;
    esac
    mark=" "
    [[ ",${services:-}," == *",$s,"* ]] && mark="*"
    printf '%s %-12s %s\n' "$mark" "$s" "$desc"
  done < <(available_services)
  echo
  echo "How to use each one: services/<name>/README.md (index: services/README.md)"
}

services=""
ports=()
cli_git_rw=0
cli_serena=""
cli_agent=""
cli_network=""
cli_continue=0
set_value=""
set_values=()
global=0
no_cache=0
down_all=0
action=run
project=""
cmd=()

# Global option, before the command.
while (($#)) && [[ "$1" == -C ]]; do
  project="${2:?-C needs a directory}"; shift 2
done

# The command (run when there is none, or when options come first).
command="run"
if (($#)) && [[ "$1" != -* ]]; then command="$1"; shift; fi

# run_options: the options of run, continue, shell, exec and urls.
run_option() {
  case "$1" in
    -a|--agent)    cli_agent="${2:?missing agent name}"; return 2 ;;
    -s|--services) services="${2:?missing service list}"; return 2 ;;
    -p|--port)     ports+=("${2:?missing port}"); return 2 ;;
    --network)     cli_network="${2:?missing network mode}"; return 2 ;;
    --git-rw)      cli_git_rw=1; return 1 ;;
    --serena)      cli_serena=1; return 1 ;;
    --no-serena)   cli_serena=0; return 1 ;;
    *)             return 0 ;;
  esac
}

# parse_run_options ARGS...: run options; stops at the first other argument,
# leaving the rest in "rest".
parse_run_options() {
  rest=()
  while (($#)); do
    local n=0
    run_option "$@" || n=$?
    if ((n)); then shift "$n"; continue; fi
    [[ "$1" == -h || "$1" == --help ]] && { help_for "$command"; exit 0; }
    rest=("$@"); return
  done
}

# expect_no_more ARGS...: fails on any leftover argument.
expect_no_more() {
  (($# == 0)) && return 0
  [[ "$1" == -* ]] && die "unknown option for roke $command: $1 (see roke help)"
  die "unexpected argument for roke $command: $1 (see roke help $command)"
}

case "$command" in
  run|continue|shell|exec|urls)
    parse_run_options "$@"
    case "$command" in
      continue) cli_continue=1 ;;
      shell)    cmd=(bash) ;;
      exec)     [[ "${rest[0]:-}" == -- ]] && rest=("${rest[@]:1}")
                ((${#rest[@]})) || die "roke exec needs a command: roke exec psql"
                cmd=("${rest[@]}"); rest=() ;;
    esac
    expect_no_more "${rest[@]}"
    [[ "$command" == urls ]] && action=urls ;;
  settings) action=settings; expect_no_more "$@" ;;
  build)
    action=build
    while (($#)); do
      case "$1" in --no-cache) no_cache=1 ;; -h|--help) help_for build; exit 0 ;; *) expect_no_more "$1" ;; esac
      shift
    done ;;
  down)
    action=down
    while (($#)); do
      case "$1" in --all) down_all=1 ;; -h|--help) help_for down; exit 0 ;; *) expect_no_more "$1" ;; esac
      shift
    done ;;
  purge) action=purge; expect_no_more "$@" ;;
  agent|service|network)
    sub="${1:-list}"; (($#)) && shift
    args=()
    for a in "$@"; do
      case "$a" in --global) global=1 ;; -h|--help) help_for "$command"; exit 0 ;; *) args+=("$a") ;; esac
    done
    case "$command $sub" in
      "agent list"|"service list"|"network list"|"network blocked")
        expect_no_more "${args[@]}" ;;
      "agent use")
        ((${#args[@]} == 1)) || die "usage: roke agent use NAME [--global]"
        set_value="${args[0]}" ;;
      "agent reset")
        expect_no_more "${args[@]}"
        ((global)) && die "roke agent reset applies to the project; the default agent is set with roke agent use NAME --global" ;;
      "service add"|"service rm")
        ((${#args[@]})) || die "usage: roke service $sub NAME..."
        set_values=("${args[@]}") ;;
      "network add"|"network rm")
        ((${#args[@]} == 1)) || die "usage: roke network $sub DEST [--global]"
        set_value="${args[0]}" ;;
      *) die "unknown command: roke $command $sub (see roke help $command)" ;;
    esac
    action="$command-$sub" ;;
  init)
    (($# <= 1)) || die "usage: roke init [GIT_URL]"
    init_config "${1:-}"
    exit 0 ;;
  update)
    expect_no_more "$@"
    [[ -d "$BOX_DIR/.git" ]] || die "$BOX_DIR is not a git clone; reinstall roke to update it"
    info "updating $BOX_DIR"
    git -C "$BOX_DIR" pull --ff-only \
      || die "could not update: $BOX_DIR has local changes or diverged (git -C $BOX_DIR status)"
    info "updated. Rebuild the images in your projects with: roke build"
    exit 0 ;;
  help|-h|--help)
    if (($#)); then help_for "$1"; else usage; fi
    exit 0 ;;
  *) die "unknown command: $command (see roke help)" ;;
esac

# roke down --all: every running roke project, without needing one here.
if [[ "$action" == down ]] && ((down_all)); then
  command -v docker >/dev/null || die "docker is not installed"
  found=0
  while read -r p; do
    [[ -n "$p" ]] || continue
    found=1
    info "stopping $p"
    docker compose -p "$p" down --remove-orphans
  done < <(docker compose ls -q --filter name=roke- 2>/dev/null)
  ((found)) || info "no roke project is running"
  exit 0
fi

[[ -d "$CONFIG_DIR" ]] \
  || die "configuration directory not found: $CONFIG_DIR (create it with: roke init)"
CONFIG_DIR="$(cd "$CONFIG_DIR" && pwd -P)"
USER_SERVICES_DIR="$CONFIG_DIR/services"
case "$CONFIG_DIR/" in "$BOX_DIR"/*)
  die "the configuration directory must live outside the roke repo" ;;
esac

# --- Project -------------------------------------------------------------------
project="${project:-$PWD}"
[[ -d "$project" ]] || die "directory does not exist: $project"
PROJECT_DIR="$(cd "$project" && pwd -P)"
HOME_REAL="$(cd "$HOME" && pwd -P)"

# The project's own configuration: ~/.config/roke/projects/<directory name>/
name="$(basename "$PROJECT_DIR")"
PROJECT_CONFIG="$CONFIG_DIR/projects/$name"
PROJECT_SERVICES_DIR="$PROJECT_CONFIG/services"

case "$action" in run|build|down|purge|urls|network-blocked)
  command -v docker >/dev/null || die "docker is not installed"
  docker compose version >/dev/null 2>&1 || die "the 'docker compose' plugin (v2) is missing" ;;
esac

# Read-only commands and --global changes do not need a project here.
check_project=1
case "$action" in
  settings|agent-list|service-list|network-list) check_project=0 ;;
  agent-use|network-add|network-rm) ((global)) && check_project=0 ;;
esac
if ((check_project)); then
# Guards against accidentally mounting more than intended.
[[ "$PROJECT_DIR" != "/" ]] || die "refusing to mount the whole /"
[[ "$PROJECT_DIR" != "$HOME_REAL" ]] || die "refusing to mount your whole \$HOME"
case "$HOME_REAL/" in "$PROJECT_DIR"/*)
  die "$PROJECT_DIR contains your \$HOME; pick a specific project directory" ;;
esac
case "$BOX_DIR/" in "$PROJECT_DIR"/*)
  die "the project contains the roke repo; the agent could modify its own sandbox" ;;
esac
case "$PROJECT_DIR/" in "$BOX_DIR"/*)
  die "the project is inside the roke repo" ;;
esac
case "$CONFIG_DIR/" in "$PROJECT_DIR"/*)
  die "the project contains your roke configuration; the agent could change its own settings" ;;
esac
case "$PROJECT_DIR/" in "$CONFIG_DIR"/*)
  die "the project is inside your roke configuration directory" ;;
esac
fi

slug="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' \
        | sed -E 's/-+/-/g; s/^-//; s/-$//')"
hash="$(printf '%s' "$PROJECT_DIR" | sha1sum | cut -c1-8)"
compose_project="roke-${slug:-project}-${hash}"

# --- Switching agents -----------------------------------------------------------
# set_setting FILE KEY VALUE: sets KEY=VALUE in a settings file, replacing an
# existing (or commented-out) line for KEY, or appending it.
set_setting() {
  local file="$1" key="$2" value="$3"
  mkdir -p "$(dirname "$file")"
  touch "$file"
  if grep -q "^${key}=" "$file"; then
    sed -i "s|^${key}=.*|${key}=${value}|" "$file"
  elif grep -q "^# *${key}=" "$file"; then
    sed -i "0,/^# *${key}=.*/s||${key}=${value}|" "$file"
  else
    printf '%s=%s\n' "$key" "$value" >> "$file"
  fi
}

check_agent_name() {
  if [[ "$1" == _* || "$1" == */* || ! -f "$BOX_DIR/agents/$1/setup.sh" ]]; then
    die "unknown agent: '$1' (available: $(available_agents | paste -sd ' '))"
  fi
  local installed
  # shellcheck source=/dev/null
  installed="$(set -a; [[ -f "$CONFIG_DIR/roke.env" ]] && source "$CONFIG_DIR/roke.env"; echo "${ROKE_AGENTS:-claude codex opencode}")"
  [[ " $installed " == *" $1 "* ]] \
    || info "note: '$1' is not in ROKE_AGENTS ($installed); add it there and run roke build"
}

# value_of FILE KEY: the value of KEY in a settings file, without quotes.
value_of() {
  [[ -f "$1" ]] || return 0
  sed -n "s/^$2=\"\{0,1\}\([^\"]*\)\"\{0,1\}$/\1/p" "$1" | tail -n1
}

# set_or_drop FILE KEY VALUE: sets KEY, or removes its line when VALUE is empty.
set_or_drop() {
  if [[ -n "$3" ]]; then
    set_setting "$1" "$2" "$3"
  elif [[ -f "$1" ]]; then
    sed -i "/^$2=/d" "$1"
  fi
}

project_env="$PROJECT_CONFIG/project.env"
global_env="$CONFIG_DIR/roke.env"

case "$action" in
  agent-use)
    check_agent_name "$set_value"
    if ((global)); then
      set_setting "$global_env" ROKE_AGENT "$set_value"
      info "default agent: $set_value (in $global_env)"
      if grep -q '^ROKE_AGENT=' "$project_env" 2>/dev/null; then
        info "note: this project has its own agent; roke agent reset to use the default"
      fi
    else
      set_setting "$project_env" ROKE_AGENT "$set_value"
      info "agent for $name: $set_value (in $project_env)"
    fi
    exit 0 ;;
  agent-reset)
    [[ -f "$project_env" ]] && sed -i '/^ROKE_AGENT=/d' "$project_env"
    info "$name uses the default agent"
    exit 0 ;;
  service-add|service-rm)
    # Start from the project's list, or from the global one if it has none.
    if grep -q '^ROKE_SERVICES=' "$project_env" 2>/dev/null; then
      current="$(value_of "$project_env" ROKE_SERVICES)"
    else
      current="$(value_of "$global_env" ROKE_SERVICES)"
    fi
    IFS=',' read -ra list <<<"${current// /}"
    if [[ "$action" == service-add ]]; then
      for s in "${set_values[@]}"; do
        if [[ "$s" == _* || "$s" == */* || ! -f "$(service_file "$s")" ]]; then
          die "unknown service: '$s' (see roke service); nothing was changed"
        fi
      done
    fi
    for s in "${set_values[@]}"; do
      if [[ "$action" == service-add ]]; then
        [[ " ${list[*]} " == *" $s "* ]] && { info "$s is already in $name"; continue; }
        list+=("$s")
        info "added to $name: $s"
      else
        [[ " ${list[*]} " == *" $s "* ]] || { info "$s is not in $name"; continue; }
        kept=()
        for x in "${list[@]}"; do [[ "$x" == "$s" ]] || kept+=("$x"); done
        list=("${kept[@]}")
        info "removed from $name: $s (its data is kept until roke purge)"
      fi
    done
    set_or_drop "$project_env" ROKE_SERVICES "$(IFS=,; echo "${list[*]}")"
    joined="$(IFS=,; echo "${list[*]:-none}")"
    info "applies from the next start; services: ${joined//,/, }"
    exit 0 ;;
  network-add|network-rm)
    if ((global)); then file="$global_env"; where="every project"; else file="$project_env"; where="$name"; fi
    if [[ "$action" == network-add ]]; then
      [[ "$set_value" =~ ^(\*\.)?[A-Za-z0-9.-]+(/[0-9]{1,2})?(:[0-9]{1,5})?$ ]] \
        || die "not a destination: '$set_value' (use a domain, IP or CIDR, with an optional :port)"
    fi
    current=" $(value_of "$file" ROKE_NETWORK_ALLOW) "
    if [[ "$action" == network-add ]]; then
      [[ "$current" == *" $set_value "* ]] && { info "$set_value is already allowed in $where"; exit 0; }
      current="$current $set_value"
      verb="allowed"
    else
      [[ "$current" == *" $set_value "* ]] || die "$set_value is not allowed in $where (see roke network)"
      current="${current/ $set_value / }"
      verb="no longer allowed"
    fi
    current="$(tr -s ' ' <<<"$current" | sed 's/^ //; s/ $//')"
    set_or_drop "$file" ROKE_NETWORK_ALLOW "${current:+\"$current\"}"
    info "$verb in $where: $set_value (from the next start; in $file)"
    exit 0 ;;
esac

# --- Settings (from your configuration directory, not from the project) -----
# Everything is exported, so these files can also override service versions,
# ports or credentials (POSTGRES_VERSION, MAILPIT_UI_PORT...).
# Order (the last one wins): global roke.env and secrets.env, then the
# project's project.env and secrets.env.
# ROKE_NETWORK_ALLOW is the exception: the project's adds to the global one.
load_settings() {
  local f
  for f in "$@"; do
    [[ -f "$f" ]] || continue
    set -a
    # shellcheck source=/dev/null
    source "$f"
    set +a
  done
}
load_settings "$CONFIG_DIR/roke.env" "$CONFIG_DIR/secrets.env"
global_allow="${ROKE_NETWORK_ALLOW:-}"
unset ROKE_NETWORK_ALLOW
load_settings "$PROJECT_CONFIG/project.env" "$PROJECT_CONFIG/secrets.env"
project_allow="${ROKE_NETWORK_ALLOW:-}"
services="${services:-${ROKE_SERVICES:-}}"
if ((${#ports[@]} == 0)) && [[ -n "${ROKE_PORTS:-}" ]]; then
  read -ra ports <<<"$ROKE_PORTS"
fi
git_rw=$(( cli_git_rw || ${ROKE_GIT_RW:-0} ))
ROKE_SERENA="${cli_serena:-${ROKE_SERENA:-0}}"; export ROKE_SERENA
ROKE_SERENA_DASHBOARD="${ROKE_SERENA_DASHBOARD:-0}"; export ROKE_SERENA_DASHBOARD

# --- Coding agent ------------------------------------------------------------------
# ROKE_AGENTS lists the agents the image is built with; no agent is the
# default, so with several installed one must be chosen.
installed_agents="${ROKE_AGENTS:-claude codex opencode}"
agent_source="default agent, roke.env"
if [[ -f "$PROJECT_CONFIG/project.env" ]] && grep -q '^ROKE_AGENT=' "$PROJECT_CONFIG/project.env"; then
  agent_source="this project"
fi
[[ -n "$cli_agent" ]] && agent_source="--agent"
ROKE_AGENT="${cli_agent:-${ROKE_AGENT:-}}"
if [[ -z "$ROKE_AGENT" ]]; then
  read -ra _installed <<<"$installed_agents"
  if ((${#_installed[@]} == 1)); then
    ROKE_AGENT="${_installed[0]}"
    agent_source="the only one installed"
  elif [[ "$action" == run ]]; then
    die "choose a coding agent: roke agent use NAME --global (installed: $installed_agents)"
  else
    ROKE_AGENT=none   # not needed to stop or remove services
  fi
fi
if [[ "$action" == run ]]; then
  if [[ "$ROKE_AGENT" == _* || "$ROKE_AGENT" == */* || ! -f "$BOX_DIR/agents/$ROKE_AGENT/setup.sh" ]]; then
    die "unknown agent: '$ROKE_AGENT' (available: $(available_agents | paste -sd ' '))"
  fi
  [[ " $installed_agents " == *" $ROKE_AGENT "* ]] \
    || die "the agent '$ROKE_AGENT' is not in ROKE_AGENTS ($installed_agents): add it there and run roke build"
fi
export ROKE_AGENT

case "$action" in
  agent-list)   list_agents; exit 0 ;;
  service-list) list_services; exit 0 ;;
esac

# --- Selected services ----------------------------------------------------------
selected=()
IFS=',' read -ra _req <<<"$services"
for s in "${_req[@]}"; do
  s="${s//[[:space:]]/}"
  [[ -n "$s" ]] || continue
  if [[ "$s" == _* || "$s" == */* || ! -f "$(service_file "$s")" ]]; then
    list_services >&2
    die "unknown service: '$s'"
  fi
  [[ " ${selected[*]} " == *" $s "* ]] || selected+=("$s")
done

compose_files=(-f "$BOX_DIR/compose.yaml")
if [[ "$action" == run || "$action" == urls || "$action" == build ]]; then
  for s in "${selected[@]}"; do
    compose_files+=(-f "$(service_file "$s")")
  done
else
  # down and purge load every service so all volumes are known.
  while read -r s; do compose_files+=(-f "$(service_file "$s")"); done < <(available_services)
fi
[[ -f "$PROJECT_CONFIG/compose.yaml" ]] && compose_files+=(-f "$PROJECT_CONFIG/compose.yaml")

# --- Network ---------------------------------------------------------------------
network_source="built-in default"
grep -q '^ROKE_NETWORK=' "$CONFIG_DIR/roke.env" 2>/dev/null && network_source="roke.env"
grep -q '^ROKE_NETWORK=' "$PROJECT_CONFIG/project.env" 2>/dev/null && network_source="this project"
[[ -n "$cli_network" ]] && network_source="--network"
ROKE_NETWORK="${cli_network:-${ROKE_NETWORK:-restricted}}"
[[ "$ROKE_NETWORK" == restricted || "$ROKE_NETWORK" == open ]] \
  || die "network mode must be restricted or open, not '$ROKE_NETWORK'"
export ROKE_NETWORK

# Allowed destinations, by layers: the base list, the agent's, the selected
# services' and yours (global and the project's). Comments and blank lines
# are ignored.
allow_files=("$BOX_DIR/docker/gateway/allow.txt" "$BOX_DIR/agents/$ROKE_AGENT/allow.txt")
for s in "${selected[@]}"; do
  allow_files+=("$(dirname "$(service_file "$s")")/allow.txt")
done
ROKE_NETWORK_ALLOW_ALL="$(
  { for f in "${allow_files[@]}"; do [[ -f "$f" ]] && cat "$f"; done
    printf '%s\n' "$global_allow" "$project_allow"
  } | sed 's/#.*//' | tr -s ' \t' '\n' | sed '/^$/d' | sort -u | paste -sd ' '
)"
export ROKE_NETWORK_ALLOW_ALL

if [[ "$action" == settings || "$action" == network-list ]]; then
  # entries FILE...: the allowed destinations listed in the files, one line.
  entries() { cat "$@" 2>/dev/null | sed 's/#.*//' | tr -s ' \t' '\n' | sed '/^$/d' | paste -sd ' '; }
  show() {  # show LABEL SOURCE ENTRIES
    printf '  %-10s %s\n' "$1" "$2"
    if [[ -n "$3" ]]; then fold -s -w 66 <<<"$3" | sed 's/ *$//; s/^/             /'; else echo "             (none)"; fi
  }
  service_labels=()
  ((${#selected[@]})) || service_labels=(none)
  for s in "${selected[@]}"; do
    case "$(service_file "$s")" in
      "$PROJECT_SERVICES_DIR"/*) service_labels+=("$s [project]") ;;
      "$USER_SERVICES_DIR"/*)    service_labels+=("$s [yours]") ;;
      *)                         service_labels+=("$s") ;;
    esac
  done
  service_allow=""
  for s in "${selected[@]}"; do
    f="$(dirname "$(service_file "$s")")/allow.txt"
    [[ -f "$f" ]] && service_allow+="$(entries "$f") "
  done
  loaded=()
  for f in "$CONFIG_DIR/roke.env" "$CONFIG_DIR/secrets.env" "$PROJECT_CONFIG/project.env" "$PROJECT_CONFIG/secrets.env" "$PROJECT_CONFIG/compose.yaml" "$PROJECT_CONFIG/AGENTS.md"; do
    [[ -f "$f" ]] && loaded+=("${f#"$CONFIG_DIR"/}")
  done
  if [[ "$action" == settings ]]; then
  echo "Project   $PROJECT_DIR"
  echo "Settings  $CONFIG_DIR: ${loaded[*]:-(no files)}"
  if [[ "$ROKE_AGENT" == none ]]; then
    echo "Agent     none chosen (roke agent use NAME --global)"
  else
    echo "Agent     $ROKE_AGENT ($agent_source)"
  fi
  echo "Network   $ROKE_NETWORK ($network_source)"
  services_text="$(printf '%s, ' "${service_labels[@]}")"
  echo "Services  ${services_text%, }"
  echo "Ports     ${ports[*]:-none}"
  echo "Serena    $( [[ $ROKE_SERENA == 1 ]] && echo on || echo off )  ·  .git: $( ((git_rw)) && echo read-write || echo read-only )"
  echo
  else
    echo "Network mode: $ROKE_NETWORK ($network_source)"
    echo
  fi
  if [[ "$ROKE_NETWORK" == open ]]; then
    echo "Allowed destinations: everything (open mode). The lists below apply in restricted mode."
  else
    echo "Allowed destinations (restricted mode), by layer:"
  fi
  show base      "docker/gateway/allow.txt" "$(entries "$BOX_DIR/docker/gateway/allow.txt")"
  [[ "$ROKE_AGENT" != none ]] && show agent "agents/$ROKE_AGENT/allow.txt" "$(entries "$BOX_DIR/agents/$ROKE_AGENT/allow.txt")"
  show services  "services/<name>/allow.txt" "${service_allow% }"
  show global    "ROKE_NETWORK_ALLOW in roke.env (roke network add --global)" "$(tr -s ' ' '\n' <<<"$global_allow" | sed '/^$/d' | paste -sd ' ')"
  show project   "ROKE_NETWORK_ALLOW in project.env (roke network add)" "$(tr -s ' ' '\n' <<<"$project_allow" | sed '/^$/d' | paste -sd ' ')"
  exit 0
fi

# The box shares the gateway's network, so its ports are published on the
# gateway, through a compose file generated for this run.
publish=()
for p in "${ports[@]}"; do
  if [[ "$p" == *:* ]]; then publish+=("$p"); else publish+=("127.0.0.1:$p:$p"); fi
done
if [[ "$ROKE_SERENA" == "1" && "$ROKE_SERENA_DASHBOARD" == "1" ]]; then
  publish+=("127.0.0.1:${ROKE_SERENA_DASHBOARD_PORT:-24282}:24282")
fi
if ((${#publish[@]})) && [[ "$action" == run || "$action" == urls ]]; then
  runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/roke"
  mkdir -p "$runtime_dir"
  ports_file="$runtime_dir/$compose_project.ports.yaml"
  { echo "services:"; echo "  gateway:"; echo "    ports:"
    for p in "${publish[@]}"; do echo "      - \"$p\""; done
  } > "$ports_file"
  compose_files+=(-f "$ports_file")
fi

export PROJECT_DIR
ROKE_CONFIG_DIR="$CONFIG_DIR"; export ROKE_CONFIG_DIR
# For paths in the project's compose files: ${ROKE_PROJECT_CONFIG}/Caddyfile
ROKE_PROJECT_CONFIG="$PROJECT_CONFIG"; export ROKE_PROJECT_CONFIG
# Must exist before Docker mounts it, or Docker creates it owned by root.
[[ "$ROKE_AGENT" == none ]] || mkdir -p "$CONFIG_DIR/agents/$ROKE_AGENT"
ROKE_SERVICES="$(IFS=','; echo "${selected[*]}")"; export ROKE_SERVICES
# ROKE_HOST_UID/GID override the container user (e.g. 0 for rootless Docker).
HOST_UID="${ROKE_HOST_UID:-$(id -u)}"; export HOST_UID
HOST_GID="${ROKE_HOST_GID:-$(id -g)}"; export HOST_GID

dc() {
  docker compose --project-directory "$BOX_DIR" -p "$compose_project" \
    "${compose_files[@]}" "$@"
}

case "$action" in
  urls)
    # The resolved compose configuration says where everything is; each
    # service's variables are told apart by comparing the configuration with
    # and without it. It is formatted inside the box's image, which has
    # Python, so nothing else is needed on the host.
    docker image inspect roke:latest >/dev/null 2>&1 \
      || die "the box's image is not built yet: run roke build first"
    base_files=(-f "$BOX_DIR/compose.yaml")
    [[ -n "${ports_file:-}" ]] && base_files+=(-f "$ports_file")
    config_json() {
      docker compose --project-directory "$BOX_DIR" -p "$compose_project" "$@" config --format json 2>/dev/null
    }
    running=false
    [[ -n "$(dc ps --status running --quiet gateway 2>/dev/null)" ]] && running=true
    read -r -d '' urls_py <<'PY' || true
import json, re, sys

d = json.load(sys.stdin)
full = d["full"]["services"]
box_env = full["box"].get("environment") or {}
base_env = d["base"]["services"]["box"].get("environment") or {}
gateway = full.get("gateway", {})
forwards = {}
for key, value in (gateway.get("environment") or {}).items():
    if key.startswith("ROKE_FORWARD_") and value:
        port, target = value.split(None, 1)
        forwards[str(port)] = target

state = "running" if d["running"] else "not running: start it with roke"
print(f"{d['project']} ({state})")
labels = list(d["services"]) + ["app", "serena"] + [t.split(":")[0] for t in forwards.values()]
col = max(12, *(len(x) for x in labels)) + 1

print("\nOpen from your browser")
rows = []
for p in gateway.get("ports") or []:
    host, published, target = p.get("host_ip") or "", p.get("published"), str(p.get("target"))
    url = f"http://127.0.0.1:{published}"
    note = "" if host == "127.0.0.1" else "(also reachable from your network)"
    if target in forwards:
        label = forwards[target].split(":")[0]
    elif target == "24282":
        label, url = "serena", url + "/dashboard/"
    else:
        label, note = "app", f"(box port {target}) {note}".strip()
    rows.append((label, url, note))
if not rows:
    print("  nothing published: roke -p PORT for the app; services publish their UIs")
for label, url, note in sorted(rows):
    print(f"  {label:<{col}}{url} {note}".rstrip())

def wrap(items, indent=2 + col, width=78):
    line = ""
    for item in items:
        if line and indent + len(line) + 1 + len(item) > width:
            print(" " * indent + line)
            line = item
        else:
            line = f"{line} {item}".strip()
    if line:
        print(" " * indent + line)

print("\nReach from inside the box")
if not d["services"]:
    print("  no services: roke -s LIST, or ROKE_SERVICES in the project's settings")
for name, conf in d["services"].items():
    env = conf["services"]["box"].get("environment") or {}
    own = [k for k in env if k not in base_env]
    ports = {int(m) for k in own for m in re.findall(rf"\b{re.escape(name)}:(\d+)", str(box_env.get(k, env[k])))}
    ports |= {int(t.split(":")[1]) for t in forwards.values() if t.split(":")[0] == name}
    # Pairs such as SMTP_HOST=mailpit and SMTP_PORT=1025.
    for k in own:
        if k.endswith("_HOST") and str(box_env.get(k, env[k])) == name:
            port = str(box_env.get(k[:-5] + "_PORT", env.get(k[:-5] + "_PORT", "")))
            if port.isdigit():
                ports.add(int(port))
    print(f"  {name:<{col}}" + (" · ".join(f"{name}:{p}" for p in sorted(ports)) or name))
    wrap([f"{k}={box_env.get(k, env[k])}" for k in own])

others = sorted(n for n in full if n not in ("box", "gateway") and n not in d["services"])
if others:
    print("\nOther containers of the project (from its compose.yaml): " + ", ".join(others))
PY
    {
      printf '{"project": "%s", "running": %s, "full": ' "$name" "$running"
      dc config --format json 2>/dev/null
      printf ', "base": '
      config_json "${base_files[@]}"
      printf ', "services": {'
      sep=""
      for s in "${selected[@]}"; do
        printf '%s"%s": ' "$sep" "$s"
        config_json "${base_files[@]}" -f "$(service_file "$s")"
        sep=", "
      done
      printf '}}'
    } | docker run --rm -i --network none --entrypoint python3 roke:latest -c "$urls_py"
    exit 0 ;;
  network-blocked)
    if [[ -z "$(dc ps --status running --quiet gateway 2>/dev/null)" ]]; then
      die "the project is not running; start it with roke, reproduce the problem, then run roke network blocked"
    fi
    dc exec -T gateway roke-gateway blocked
    echo
    echo "To allow one: roke network add DEST (in this project), or roke network add DEST --global"
    exit 0 ;;
  build)
    # The box, the gateway and any selected service with its own image.
    if ((no_cache)); then dc build --pull --no-cache; else dc build --pull; fi
    exit 0 ;;
  down)  dc down --remove-orphans; exit 0 ;;
  purge) dc down --remove-orphans --volumes; exit 0 ;;
esac


run_args=(--rm)
((cli_continue)) && run_args+=(-e ROKE_CONTINUE=1)
[[ -t 0 && -t 1 ]] || run_args+=(-T)


# Your instructions for every agent.
if [[ -f "$CONFIG_DIR/AGENTS.md" ]]; then
  run_args+=(-v "$CONFIG_DIR/AGENTS.md:/run/roke/user-AGENTS.md:ro")
fi

# The project's private instructions for the agent: only this file is
# mounted, never the directory, which may hold secrets.
if [[ -f "$PROJECT_CONFIG/AGENTS.md" ]]; then
  run_args+=(-v "$PROJECT_CONFIG/AGENTS.md:/run/roke/project-AGENTS.md:ro")
fi

# Read-only .git: prevents the agent from planting hooks or .git/config
# settings (core.fsmonitor, core.hooksPath...) that would run on your host.
if ((git_rw == 0)) && [[ -d "$PROJECT_DIR/.git" ]]; then
  run_args+=(-v "$PROJECT_DIR/.git:$PROJECT_DIR/.git:ro" -e ROKE_GIT_READONLY=1)
fi

# Without a command, the entrypoint runs the agent.

info "project: $PROJECT_DIR  ·  agent: $ROKE_AGENT  ·  network: $ROKE_NETWORK  ·  services: ${ROKE_SERVICES:-none}  ·  .git: $( ((git_rw)) && echo rw || echo ro )  ·  serena: $( [[ $ROKE_SERENA == 1 ]] && echo yes || echo no )"
dc run "${run_args[@]}" box "${cmd[@]}"
