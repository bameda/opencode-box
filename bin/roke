#!/usr/bin/env bash
# roke — run a coding agent in a container that can only see the given project,
# plus whatever auxiliary services (DB, cache, mail, proxy...) you ask for.
set -euo pipefail

BOX_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
SERVICES_DIR="$BOX_DIR/services"
# Your personal configuration (settings, projects, agent configuration), kept
# outside this repository.
CONFIG_DIR="${ROKE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/roke}"
USER_SERVICES_DIR="$CONFIG_DIR/services"
PROJECT_SERVICES_DIR=""   # set once the project is known

die()  { printf 'roke: %s\n' "$*" >&2; exit 1; }
info() { printf '[roke] %s\n' "$*" >&2; }

usage() {
  cat <<'USAGE'
Usage: roke [options] [PROJECT_DIR] [-- COMMAND...]

Run a coding agent in a container with access to PROJECT_DIR only
(default: $PWD).

Options:
  -a, --agent NAME       Coding agent to run this time (see --list)
      --set-agent NAME   Agent for this project; "default" to use the default
      --default-agent NAME
                         Default agent, for projects without one of their own
  -s, --services LIST    Comma-separated services from the catalog.
                         E.g. -s postgres,redis,mailpit   (see --list)
  -l, --list             List the agents and the services available to the project
      --network MODE     restricted (default) or open, this time
      --allow ENTRY      Allow a destination for this project: domain, IP or
                         CIDR, with an optional :port (db.example.com:5432)
      --blocked          Show what the project tried to reach and was denied
  -p, --port PORT        Publish a port of the box on
                         127.0.0.1 (repeatable). E.g. -p 3000
      --git-rw           Mount .git read-write (read-only by default)
      --serena           Enable Serena (semantic code navigation/editing MCP)
      --no-serena        Disable it even if the project enables it
      --shell            Open bash in the box instead of the agent
      --build            Rebuild the images (with --pull) before starting
      --rebuild          Same, without cache (updates agents on 'latest'/'stable')
      --down             Stop and remove the project's services (keeps data)
      --purge            Like --down, and also delete the project's volumes
      --init [GIT_URL]   Create the configuration directory: clone it from your
                         private repo if GIT_URL is given, then add any missing
                         file from the examples (never overwrites anything)
  -h, --help             Show this help

Anything after "--" replaces the default command (the agent):
  roke -- claude --continue
  roke -- opencode --continue
  roke -s postgres -- psql

Configuration directory: ~/.config/roke (or $ROKE_CONFIG_DIR), out of the
agent's reach:
  roke.env, secrets.env     global settings (ROKE_AGENT...) and API keys
  AGENTS.md                  your instructions for every agent
  projects/<dir-name>/       one directory per project, named after it:
    project.env              ROKE_SERVICES, ROKE_PORTS, ROKE_SERENA...
    secrets.env              the project's secrets
    compose.yaml             compose override for the project
    AGENTS.md                private instructions for the agent
    services/<name>/         services only the project uses
  services/<name>/           your own services (same layout as the catalog)
  agents/<agent>/            each agent's own configuration
USAGE
}

# Each agent is a directory agents/<name>/ with an install.sh and a setup.sh.
available_agents() {
  local d
  for d in "$BOX_DIR"/agents/*/; do
    [[ -f "$d/setup.sh" ]] || continue
    d="$(basename "$d")"
    [[ "$d" == _* ]] || printf '%s\n' "$d"
  done
}

# Each service is a directory <name>/ with a compose.yaml inside. They are
# looked up in the project's configuration, then in yours, then in the
# catalog: the first one found wins.
service_dirs() {
  [[ -n "$PROJECT_SERVICES_DIR" ]] && printf '%s\n' "$PROJECT_SERVICES_DIR"
  printf '%s\n' "$USER_SERVICES_DIR" "$SERVICES_DIR"
}

available_services() {
  local dir d
  while read -r dir; do
    for d in "$dir"/*/; do
      [[ -f "$d/compose.yaml" ]] || continue
      d="$(basename "$d")"
      [[ "$d" == _* ]] || printf '%s\n' "$d"
    done
  done < <(service_dirs) | sort -u
}

service_file() {
  local dir
  while read -r dir; do
    if [[ -f "$dir/$1/compose.yaml" ]]; then
      printf '%s/%s/compose.yaml' "$dir" "$1"
      return
    fi
  done < <(service_dirs)
  printf '%s/%s/compose.yaml' "$SERVICES_DIR" "$1"
}

init_config() {
  local repo="${1:-}" created=0 src rel
  if [[ -n "$repo" ]]; then
    if [[ -e "$CONFIG_DIR" ]]; then
      die "$CONFIG_DIR already exists; remove it or move it away to clone $repo"
    fi
    command -v git >/dev/null || die "git is not installed"
    git clone "$repo" "$CONFIG_DIR"
  fi
  mkdir -p "$CONFIG_DIR"
  while IFS= read -r -d '' src; do
    rel="${src#"$BOX_DIR/examples/config/"}"
    # Files the example's own .gitignore would hide from git are stored as
    # <name>.example (secrets.env.example -> secrets.env).
    rel="${rel%.example}"
    if [[ ! -e "$CONFIG_DIR/$rel" ]]; then
      mkdir -p "$(dirname "$CONFIG_DIR/$rel")"
      cp "$src" "$CONFIG_DIR/$rel"
      echo "  created $rel"
      created=1
    fi
  done < <(find "$BOX_DIR/examples/config" -type f -print0 | sort -z)
  chmod 600 "$CONFIG_DIR/secrets.env" 2>/dev/null || true
  ((created)) || echo "  nothing to do: every file already exists"
  echo "Configuration directory: $CONFIG_DIR"
  if [[ ! -d "$CONFIG_DIR/.git" ]]; then
    echo "Tip: make it a private git repo: git -C \"$CONFIG_DIR\" init"
  fi
}

list_services() {
  local s desc
  echo "Coding agents (--set-agent for this project, --default-agent for the default):"
  while read -r s; do
    desc="$(sed -n '1s/^# *//p' "$BOX_DIR/agents/$s/README.md" 2>/dev/null)"
    [[ " ${installed_agents:-} " == *" $s "* ]] || desc="$desc (not installed)"
    [[ "$s" == "${ROKE_AGENT:-}" ]] && desc="$desc  <- selected (${agent_source:-})"
    printf '  %-12s %s\n' "$s" "$desc"
  done < <(available_agents)
  echo
  echo "Available services:"
  while read -r s; do
    desc="$(sed -n '1s/^# *//p' "$(service_file "$s")")"
    case "$(service_file "$s")" in
      "$PROJECT_SERVICES_DIR"/*) desc="[project] $desc" ;;
      "$USER_SERVICES_DIR"/*)    desc="[yours] $desc" ;;
    esac
    printf '  %-12s %s\n' "$s" "$desc"
  done < <(available_services)
  echo
  echo "How to use each one: services/<name>/README.md (index: services/README.md)"
}

services=""
ports=()
cli_git_rw=0
cli_serena=""
cli_agent=""
cli_network=""
set_value=""
action=run
build=""
project=""
cmd=()

while (($#)); do
  case "$1" in
    -a|--agent)    cli_agent="${2:?missing agent name}"; shift 2 ;;
    --set-agent)   action=set-agent; set_value="${2:?missing agent name}"; shift 2 ;;
    --default-agent)
                   action=default-agent; set_value="${2:?missing agent name}"; shift 2 ;;
    -s|--services) services="${2:?missing service list}"; shift 2 ;;
    -l|--list)     action=list; shift ;;
    --init)
      if [[ -n "${2:-}" && "$2" != -* ]]; then init_config "$2"; else init_config; fi
      exit 0 ;;
    -p|--port)     ports+=("${2:?missing port}"); shift 2 ;;
    --network)     cli_network="${2:?missing network mode}"; shift 2 ;;
    --allow)       action=allow; set_value="${2:?missing destination}"; shift 2 ;;
    --blocked)     action=blocked; shift ;;
    --git-rw)      cli_git_rw=1; shift ;;
    --serena)      cli_serena=1; shift ;;
    --no-serena)   cli_serena=0; shift ;;
    --shell)       cmd=(bash); shift ;;
    --build)       build=pull; shift ;;
    --rebuild)     build=nocache; shift ;;
    --down)        action=down; shift ;;
    --purge)       action=purge; shift ;;
    -h|--help)     usage; exit 0 ;;
    --)            shift; cmd=("$@"); break ;;
    -*)            die "unknown option: $1 (see --help)" ;;
    *)
      [[ -z "$project" ]] || die "only one project directory is allowed"
      project="$1"; shift ;;
  esac
done

[[ -d "$CONFIG_DIR" ]] \
  || die "configuration directory not found: $CONFIG_DIR (create it with: roke --init)"
CONFIG_DIR="$(cd "$CONFIG_DIR" && pwd -P)"
USER_SERVICES_DIR="$CONFIG_DIR/services"
case "$CONFIG_DIR/" in "$BOX_DIR"/*)
  die "the configuration directory must live outside the roke repo" ;;
esac

# --- Project -------------------------------------------------------------------
project="${project:-$PWD}"
[[ -d "$project" ]] || die "directory does not exist: $project"
PROJECT_DIR="$(cd "$project" && pwd -P)"
HOME_REAL="$(cd "$HOME" && pwd -P)"

# The project's own configuration: ~/.config/roke/projects/<directory name>/
name="$(basename "$PROJECT_DIR")"
PROJECT_CONFIG="$CONFIG_DIR/projects/$name"
PROJECT_SERVICES_DIR="$PROJECT_CONFIG/services"

if [[ "$action" == run || "$action" == down || "$action" == purge ]]; then
  command -v docker >/dev/null || die "docker is not installed"
  docker compose version >/dev/null 2>&1 || die "the 'docker compose' plugin (v2) is missing"
fi

if [[ "$action" != list && "$action" != default-agent ]]; then
# Guards against accidentally mounting more than intended.
[[ "$PROJECT_DIR" != "/" ]] || die "refusing to mount the whole /"
[[ "$PROJECT_DIR" != "$HOME_REAL" ]] || die "refusing to mount your whole \$HOME"
case "$HOME_REAL/" in "$PROJECT_DIR"/*)
  die "$PROJECT_DIR contains your \$HOME; pick a specific project directory" ;;
esac
case "$BOX_DIR/" in "$PROJECT_DIR"/*)
  die "the project contains the roke repo; the agent could modify its own sandbox" ;;
esac
case "$PROJECT_DIR/" in "$BOX_DIR"/*)
  die "the project is inside the roke repo" ;;
esac
case "$CONFIG_DIR/" in "$PROJECT_DIR"/*)
  die "the project contains your roke configuration; the agent could change its own settings" ;;
esac
case "$PROJECT_DIR/" in "$CONFIG_DIR"/*)
  die "the project is inside your roke configuration directory" ;;
esac
fi

slug="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' \
        | sed -E 's/-+/-/g; s/^-//; s/-$//')"
hash="$(printf '%s' "$PROJECT_DIR" | sha1sum | cut -c1-8)"
compose_project="roke-${slug:-project}-${hash}"

# --- Switching agents -----------------------------------------------------------
# set_setting FILE KEY VALUE: sets KEY=VALUE in a settings file, replacing an
# existing (or commented-out) line for KEY, or appending it.
set_setting() {
  local file="$1" key="$2" value="$3"
  mkdir -p "$(dirname "$file")"
  touch "$file"
  if grep -q "^${key}=" "$file"; then
    sed -i "s|^${key}=.*|${key}=${value}|" "$file"
  elif grep -q "^# *${key}=" "$file"; then
    sed -i "0,/^# *${key}=.*/s||${key}=${value}|" "$file"
  else
    printf '%s=%s\n' "$key" "$value" >> "$file"
  fi
}

check_agent_name() {
  if [[ "$1" == _* || "$1" == */* || ! -f "$BOX_DIR/agents/$1/setup.sh" ]]; then
    die "unknown agent: '$1' (available: $(available_agents | paste -sd ' '))"
  fi
  local installed
  # shellcheck source=/dev/null
  installed="$(set -a; [[ -f "$CONFIG_DIR/roke.env" ]] && source "$CONFIG_DIR/roke.env"; echo "${ROKE_AGENTS:-claude opencode}")"
  [[ " $installed " == *" $1 "* ]] \
    || info "note: '$1' is not in ROKE_AGENTS ($installed); add it there and run roke --build"
}

case "$action" in
  allow)
    [[ "$set_value" =~ ^(\*\.)?[A-Za-z0-9.-]+(/[0-9]{1,2})?(:[0-9]{1,5})?$ ]] \
      || die "not a destination: '$set_value' (use a domain, IP or CIDR, with an optional :port)"
    current=""
    if [[ -f "$PROJECT_CONFIG/project.env" ]]; then
      current="$(sed -n 's/^ROKE_NETWORK_ALLOW="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$PROJECT_CONFIG/project.env" | tail -n1)"
    fi
    if [[ " $current " == *" $set_value "* ]]; then
      info "$set_value is already allowed for $name"
    else
      set_setting "$PROJECT_CONFIG/project.env" ROKE_NETWORK_ALLOW "\"${current:+$current }$set_value\""
      info "allowed for $name: $set_value (from the next start; in $PROJECT_CONFIG/project.env)"
    fi
    exit 0 ;;
  default-agent)
    check_agent_name "$set_value"
    set_setting "$CONFIG_DIR/roke.env" ROKE_AGENT "$set_value"
    info "default agent: $set_value (in $CONFIG_DIR/roke.env)"
    if [[ -f "$PROJECT_CONFIG/project.env" ]] && grep -q '^ROKE_AGENT=' "$PROJECT_CONFIG/project.env"; then
      info "note: this project has its own agent; roke --set-agent default to use the default"
    fi
    exit 0 ;;
  set-agent)
    if [[ "$set_value" == default ]]; then
      if [[ -f "$PROJECT_CONFIG/project.env" ]]; then
        sed -i '/^ROKE_AGENT=/d' "$PROJECT_CONFIG/project.env"
      fi
      info "$name uses the default agent"
    else
      check_agent_name "$set_value"
      set_setting "$PROJECT_CONFIG/project.env" ROKE_AGENT "$set_value"
      info "agent for $name: $set_value (in $PROJECT_CONFIG/project.env)"
    fi
    exit 0 ;;
esac

# --- Settings (from your configuration directory, not from the project) -----
# Everything is exported, so these files can also override service versions,
# ports or credentials (POSTGRES_VERSION, MAILPIT_UI_PORT...).
# Order (the last one wins): global roke.env and secrets.env, then the
# project's project.env and secrets.env.
# ROKE_NETWORK_ALLOW is the exception: the project's adds to the global one.
load_settings() {
  local f
  for f in "$@"; do
    [[ -f "$f" ]] || continue
    set -a
    # shellcheck source=/dev/null
    source "$f"
    set +a
  done
}
load_settings "$CONFIG_DIR/roke.env" "$CONFIG_DIR/secrets.env"
global_allow="${ROKE_NETWORK_ALLOW:-}"
unset ROKE_NETWORK_ALLOW
load_settings "$PROJECT_CONFIG/project.env" "$PROJECT_CONFIG/secrets.env"
project_allow="${ROKE_NETWORK_ALLOW:-}"
services="${services:-${ROKE_SERVICES:-}}"
if ((${#ports[@]} == 0)) && [[ -n "${ROKE_PORTS:-}" ]]; then
  read -ra ports <<<"$ROKE_PORTS"
fi
git_rw=$(( cli_git_rw || ${ROKE_GIT_RW:-0} ))
ROKE_SERENA="${cli_serena:-${ROKE_SERENA:-0}}"; export ROKE_SERENA
ROKE_SERENA_DASHBOARD="${ROKE_SERENA_DASHBOARD:-0}"; export ROKE_SERENA_DASHBOARD

# --- Coding agent ------------------------------------------------------------------
# ROKE_AGENTS lists the agents the image is built with; no agent is the
# default, so with several installed one must be chosen.
installed_agents="${ROKE_AGENTS:-claude opencode}"
agent_source="default"
if [[ -f "$PROJECT_CONFIG/project.env" ]] && grep -q '^ROKE_AGENT=' "$PROJECT_CONFIG/project.env"; then
  agent_source="this project"
fi
[[ -n "$cli_agent" ]] && agent_source="--agent"
ROKE_AGENT="${cli_agent:-${ROKE_AGENT:-}}"
if [[ -z "$ROKE_AGENT" ]]; then
  read -ra _installed <<<"$installed_agents"
  if ((${#_installed[@]} == 1)); then
    ROKE_AGENT="${_installed[0]}"
    agent_source="the only one installed"
  elif [[ "$action" == run ]]; then
    die "choose a coding agent: roke --default-agent NAME (installed: $installed_agents)"
  else
    ROKE_AGENT=none   # not needed to stop or remove services
  fi
fi
if [[ "$action" == run ]]; then
  if [[ "$ROKE_AGENT" == _* || "$ROKE_AGENT" == */* || ! -f "$BOX_DIR/agents/$ROKE_AGENT/setup.sh" ]]; then
    die "unknown agent: '$ROKE_AGENT' (available: $(available_agents | paste -sd ' '))"
  fi
  [[ " $installed_agents " == *" $ROKE_AGENT "* ]] \
    || die "the agent '$ROKE_AGENT' is not in ROKE_AGENTS ($installed_agents): add it there and run roke --build"
fi
export ROKE_AGENT

if [[ "$action" == list ]]; then
  list_services
  exit 0
fi

# --- Selected services ----------------------------------------------------------
selected=()
IFS=',' read -ra _req <<<"$services"
for s in "${_req[@]}"; do
  s="${s//[[:space:]]/}"
  [[ -n "$s" ]] || continue
  if [[ "$s" == _* || "$s" == */* || ! -f "$(service_file "$s")" ]]; then
    list_services >&2
    die "unknown service: '$s'"
  fi
  [[ " ${selected[*]} " == *" $s "* ]] || selected+=("$s")
done

compose_files=(-f "$BOX_DIR/compose.yaml")
if [[ "$action" == run ]]; then
  for s in "${selected[@]}"; do
    compose_files+=(-f "$(service_file "$s")")
  done
else
  # --down/--purge load every fragment so all volumes are known.
  while read -r s; do compose_files+=(-f "$(service_file "$s")"); done < <(available_services)
fi
[[ -f "$PROJECT_CONFIG/compose.yaml" ]] && compose_files+=(-f "$PROJECT_CONFIG/compose.yaml")

# --- Network ---------------------------------------------------------------------
ROKE_NETWORK="${cli_network:-${ROKE_NETWORK:-restricted}}"
[[ "$ROKE_NETWORK" == restricted || "$ROKE_NETWORK" == open ]] \
  || die "network mode must be restricted or open, not '$ROKE_NETWORK'"
export ROKE_NETWORK

# Allowed destinations, by layers: the base list, the agent's, the selected
# services' and yours (global and the project's). Comments and blank lines
# are ignored.
allow_files=("$BOX_DIR/docker/gateway/allow.txt" "$BOX_DIR/agents/$ROKE_AGENT/allow.txt")
for s in "${selected[@]}"; do
  allow_files+=("$(dirname "$(service_file "$s")")/allow.txt")
done
ROKE_NETWORK_ALLOW_ALL="$(
  { for f in "${allow_files[@]}"; do [[ -f "$f" ]] && cat "$f"; done
    printf '%s\n' "$global_allow" "$project_allow"
  } | sed 's/#.*//' | tr -s ' \t' '\n' | sed '/^$/d' | sort -u | paste -sd ' '
)"
export ROKE_NETWORK_ALLOW_ALL

# The box shares the gateway's network, so its ports are published on the
# gateway, through a compose file generated for this run.
publish=()
for p in "${ports[@]}"; do
  if [[ "$p" == *:* ]]; then publish+=("$p"); else publish+=("127.0.0.1:$p:$p"); fi
done
if [[ "$ROKE_SERENA" == "1" && "$ROKE_SERENA_DASHBOARD" == "1" ]]; then
  publish+=("127.0.0.1:${ROKE_SERENA_DASHBOARD_PORT:-24282}:24282")
fi
if ((${#publish[@]})) && [[ "$action" == run ]]; then
  runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/roke"
  mkdir -p "$runtime_dir"
  ports_file="$runtime_dir/$compose_project.ports.yaml"
  { echo "services:"; echo "  gateway:"; echo "    ports:"
    for p in "${publish[@]}"; do echo "      - \"$p\""; done
  } > "$ports_file"
  compose_files+=(-f "$ports_file")
fi

export PROJECT_DIR
ROKE_CONFIG_DIR="$CONFIG_DIR"; export ROKE_CONFIG_DIR
# For paths in the project's compose files: ${ROKE_PROJECT_CONFIG}/Caddyfile
ROKE_PROJECT_CONFIG="$PROJECT_CONFIG"; export ROKE_PROJECT_CONFIG
# Must exist before Docker mounts it, or Docker creates it owned by root.
[[ "$ROKE_AGENT" == none ]] || mkdir -p "$CONFIG_DIR/agents/$ROKE_AGENT"
ROKE_SERVICES="$(IFS=','; echo "${selected[*]}")"; export ROKE_SERVICES
# ROKE_HOST_UID/GID override the container user (e.g. 0 for rootless Docker).
HOST_UID="${ROKE_HOST_UID:-$(id -u)}"; export HOST_UID
HOST_GID="${ROKE_HOST_GID:-$(id -g)}"; export HOST_GID

dc() {
  docker compose --project-directory "$BOX_DIR" -p "$compose_project" \
    "${compose_files[@]}" "$@"
}

case "$action" in
  blocked)
    if [[ -z "$(dc ps --status running --quiet gateway 2>/dev/null)" ]]; then
      die "the project is not running; start it with roke, reproduce the problem, then run roke --blocked"
    fi
    dc exec -T gateway roke-gateway blocked
    echo
    echo "To allow one: roke --allow DESTINATION (in this project), or ROKE_NETWORK_ALLOW in roke.env"
    exit 0 ;;
  down)  dc down --remove-orphans; exit 0 ;;
  purge) dc down --remove-orphans --volumes; exit 0 ;;
esac


case "$build" in
  # Builds the box plus any selected service with its own image (ssh-target).
  pull)    dc build --pull ;;
  nocache) dc build --pull --no-cache ;;
esac

run_args=(--rm)
[[ -t 0 && -t 1 ]] || run_args+=(-T)


# Your instructions for every agent.
if [[ -f "$CONFIG_DIR/AGENTS.md" ]]; then
  run_args+=(-v "$CONFIG_DIR/AGENTS.md:/run/roke/user-AGENTS.md:ro")
fi

# The project's private instructions for the agent: only this file is
# mounted, never the directory, which may hold secrets.
if [[ -f "$PROJECT_CONFIG/AGENTS.md" ]]; then
  run_args+=(-v "$PROJECT_CONFIG/AGENTS.md:/run/roke/project-AGENTS.md:ro")
fi

# Read-only .git: prevents the agent from planting hooks or .git/config
# settings (core.fsmonitor, core.hooksPath...) that would run on your host.
if ((git_rw == 0)) && [[ -d "$PROJECT_DIR/.git" ]]; then
  run_args+=(-v "$PROJECT_DIR/.git:$PROJECT_DIR/.git:ro" -e ROKE_GIT_READONLY=1)
fi

# Without a command, the entrypoint runs the agent.

info "project: $PROJECT_DIR  ·  agent: $ROKE_AGENT  ·  network: $ROKE_NETWORK  ·  services: ${ROKE_SERVICES:-none}  ·  .git: $( ((git_rw)) && echo rw || echo ro )  ·  serena: $( [[ $ROKE_SERENA == 1 ]] && echo yes || echo no )"
dc run "${run_args[@]}" box "${cmd[@]}"
